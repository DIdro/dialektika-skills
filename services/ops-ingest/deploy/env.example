# Скопировать в /opt/ops-ingest/ingest/.env и заполнить

# Адрес call-pipeline — внутренний, прямо в uvicorn, мимо nginx: путь /web наружу
# не проксируется, и через nginx проверка сессии не пройдёт.
OPS_INGEST_CP_BASE=http://127.0.0.1:8001
OPS_INGEST_CP_TOKEN=
ANTHROPIC_API_KEY=
OPS_INGEST_DB=/opt/ops-ingest/ingest/state.db

# Обязательно. Id владельца в call-pipeline: с ним сверяется сессия кабинета.
# Пустое значение — отказ всем. Взять: войти в кабинет и открыть /api/web/me.
OPS_INGEST_OWNER_USER_ID=
# Имя и как зовут в разговорах: по нему модель опознаёт владельца среди говорящих
OPS_INGEST_OWNER_NAME=

# Куда писать принятое: задайте ОДИН из двух вариантов.
# 1. Мионика: токен или файл с OAuth-кредами
OPS_INGEST_MIONIKA_TOKEN=
OPS_INGEST_MIONIKA_CREDS=
# 2. Файлы: проекты по строке "ключ — название — о чём", принятое — .md и .json в папку
OPS_INGEST_PROJECTS_FILE=
OPS_INGEST_ACCEPTED_DIR=

# Необязательно: пинг в Telegram «N звонков ждут разбора»
OPS_INGEST_BOT_TOKEN=
OPS_INGEST_OWNER_CHAT_ID=
OPS_INGEST_DASHBOARD_URL=

# 1 — удалять job в call-pipeline после укладки в очередь. Тогда кнопки скачивания
# расшифровки на странице «Разбор» перестанут работать.
OPS_INGEST_SKIP_AFTER_PROCESS=0
