# Database location (SQLite file path on the VPS)
PIPELINE_DATABASE_URL=sqlite:////var/lib/call-pipeline/pipeline.db

# Where audio/transcripts/drafts live on disk
PIPELINE_STORAGE_ROOT=/var/lib/call-pipeline

# Symmetric key for at-rest encryption of user secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIPELINE_DB_ENCRYPTION_KEY=

# Long random token gating /admin endpoints (used by CLI's pipeline admin commands)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PIPELINE_ADMIN_TOKEN=

# Anthropic API key for the classifier worker
ANTHROPIC_API_KEY=

# HuggingFace token for pyannote.audio diarization model
HF_TOKEN=

# HuggingFace cache root (the `pipeline` system user has no /home, so HF Hub
# would otherwise fail with PermissionError when writing model refs).
HF_HOME=/var/lib/call-pipeline/.hf-cache

# OpenAI API key: titles for Telemost recordings (optional)
OPENAI_API_KEY=

# Telemost control bot -> API client: an existing pipeline user's credentials.
BOT_API_URL=http://127.0.0.1:8001
BOT_USER_ID=
BOT_BEARER_TOKEN=

# Telemost recorder + control bot (records Telemost calls, diarizes via the
# pipeline). Reuses BOT_API_URL / BOT_USER_ID / BOT_BEARER_TOKEN above.
TELEMOST_BOT_TOKEN=
TELEMOST_WHITELIST=
# Telegram ids of bot admins, comma-separated
TELEMOST_ADMIN_IDS=
# Groq API key: fast speaker-less transcript right after a recording (optional)
GROQ_API_KEY=

# Project list for the classifier: one per line, "key — name — about"
PIPELINE_PROJECTS_FILE=/etc/call-pipeline/projects.md
