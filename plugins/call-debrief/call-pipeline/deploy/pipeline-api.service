[Unit]
Description=call-pipeline FastAPI
After=network.target

[Service]
Type=simple
User=pipeline
WorkingDirectory=/opt/call-pipeline/server
EnvironmentFile=/etc/call-pipeline/env
ExecStart=/opt/call-pipeline/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
